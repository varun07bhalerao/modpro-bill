{
  "version": 2,
  "functions": {
    "api/index.py": {
      "excludeFiles": "{frontend/**,sample-data/**,storage/original-documents/**,storage/tagged-documents/**,docs/**,reference_materials/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/storage/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
